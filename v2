<!-- Start of HashBro Business Concierge Widget -->
<div id="hb-widget-wrapper">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
    /* 1. Reset inherited styles */
    #hb-widget-wrapper { all: initial; font-family: 'Inter', sans-serif; font-size: 15px; z-index: 2147483647; position: relative; }
    #hb-widget-wrapper * { box-sizing: border-box; font-family: inherit; }

    /* 2. Theme Variables - Modern Tech Palette */
    #hb-widget-wrapper {
        --bg-chatbot: #ffffff; 
        --bg-header: linear-gradient(135deg, #0f172a, #1e293b); 
        --text-header: #ffffff; 
        --bg-chat-display: #f8fafc; 
        --bg-user-message: #0f172a; 
        --text-user-message: #ffffff; 
        --bg-bot-message: #ffffff; 
        --text-bot-message: #334155; 
        --bg-input-container: #ffffff; 
        --border-color: #e2e8f0; 
        --bg-input: #f1f5f9; 
        --text-input: #0f172a; 
        --bg-send-button: #0f172a; 
        --text-send-button: #ffffff; 
        --bg-send-button-hover: #334155; 
        --bg-option-button: #f1f5f9; 
        --text-option-button: #0f172a; 
        --bg-option-button-hover: #e2e8f0; 
        --shadow-soft: 0 8px 16px -4px rgba(0, 0, 0, 0.05); 
        --shadow-chatbot: 0 25px 50px -12px rgba(0, 0, 0, 0.15); 
        --minimized-icon-color: #ffffff; 
        --minimized-bg: #0f172a; 
    }

    #hb-widget-wrapper.hb-dark-mode {
        --bg-chatbot: #0f172a; 
        --bg-header: linear-gradient(135deg, #020617, #0f172a); 
        --text-header: #f8fafc; 
        --bg-chat-display: #020617; 
        --bg-user-message: #3b82f6; 
        --text-user-message: #ffffff; 
        --bg-bot-message: #1e293b; 
        --text-bot-message: #f1f5f9; 
        --bg-input-container: #0f172a; 
        --border-color: #1e293b; 
        --bg-input: #1e293b; 
        --text-input: #f8fafc; 
        --bg-send-button: #3b82f6; 
        --bg-send-button-hover: #2563eb; 
        --bg-option-button: #1e293b; 
        --text-option-button: #93c5fd; 
        --bg-option-button-hover: #334155; 
        --minimized-bg: #3b82f6;
        --minimized-icon-color: #ffffff;
    }

    #hb-widget-wrapper ::-webkit-scrollbar { width: 4px; }
    #hb-widget-wrapper ::-webkit-scrollbar-track { background: transparent; }
    #hb-widget-wrapper ::-webkit-scrollbar-thumb { background-color: var(--border-color); border-radius: 10px; }

    #hb-widget-wrapper .chatbot-container { position: fixed; bottom: 24px; right: 24px; z-index: 2147483647; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    #hb-widget-wrapper .chatbot { width: 360px; max-width: 90vw; height: 600px; max-height: 85vh; border-radius: 24px; background-color: var(--bg-chatbot); box-shadow: var(--shadow-chatbot); display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--border-color); }
    
    #hb-widget-wrapper .chatbot.minimized { width: auto; height: auto; border-radius: 0; background: transparent; box-shadow: none; border: none; overflow: visible; }
    #hb-widget-wrapper .chatbot.minimized > :not(.chatbot-header) { display: none; }
    #hb-widget-wrapper .chatbot.minimized .chatbot-header { background: transparent; padding: 0; border: none; box-shadow: none; overflow: visible; }
    #hb-widget-wrapper .chatbot.minimized .chatbot-header span, #hb-widget-wrapper .chatbot.minimized .header-controls > :not(.minimize-button) { display: none; }

    #hb-widget-wrapper .chatbot-header { background: var(--bg-header); color: var(--text-header); padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
    #hb-widget-wrapper .chatbot-header span { font-weight: 600; font-size: 1.05em; letter-spacing: -0.3px; display: flex; align-items: center; gap: 8px;}
    #hb-widget-wrapper .header-controls { display: flex; align-items: center; gap: 10px; }
    #hb-widget-wrapper .header-button { background: none; border: none; color: var(--text-header); font-size: 1.2em; cursor: pointer; opacity: 0.8; transition: 0.2s ease; display: flex; align-items: center; justify-content: center; padding: 4px; border-radius: 8px; outline: none; -webkit-tap-highlight-color: transparent;}
    #hb-widget-wrapper .header-button:hover { opacity: 1; transform: scale(1.1); }

    @keyframes hbPulseAttention {
        0%, 85% { transform: scale(1); box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        92% { transform: scale(1.12); box-shadow: 0 0 20px rgba(15, 23, 42, 0.4); }
        100% { transform: scale(1); box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    }

    #hb-widget-wrapper .chatbot.minimized .minimize-button.header-button { 
        padding: 0; display: flex; align-items: center; justify-content: center;
        color: var(--minimized-icon-color); background-color: var(--minimized-bg); 
        border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.2); 
        width: 60px; height: 60px; min-width: 60px; min-height: 60px; flex-shrink: 0; 
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: hbPulseAttention 5s infinite ease-in-out; -webkit-tap-highlight-color: transparent; outline: none;
    }
    #hb-widget-wrapper .chatbot.minimized .minimize-button.header-button:hover { transform: scale(1.08); animation: none; background-color: var(--minimized-bg); }
    #hb-widget-wrapper .chatbot.minimized .minimize-button.header-button svg { width: 28px; height: 28px; fill: var(--minimized-icon-color); flex-shrink: 0; }

    #hb-widget-wrapper .settings-panel { max-height: 0; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease; background-color: var(--bg-chatbot); display: flex; gap: 8px; padding: 0 16px; border-bottom: 1px solid var(--border-color); }
    #hb-widget-wrapper .settings-panel.open { max-height: 60px; padding: 12px 16px; overflow: visible; }
    #hb-widget-wrapper .settings-btn { background: var(--bg-input); color: var(--text-bot-message); border: none; border-radius: 8px; padding: 8px; flex: 1; font-size: 0.8em; font-weight: 500; cursor: pointer; transition: 0.2s ease; outline: none; }
    #hb-widget-wrapper .settings-btn:hover { filter: brightness(0.95); transform: translateY(-1px); }

    #hb-widget-wrapper .chat-display { flex: 1; overflow-y: auto; padding: 16px; background-color: var(--bg-chat-display); display: flex; flex-direction: column; }
    #hb-widget-wrapper .message-row { display: flex; align-items: flex-end; margin-bottom: 16px; max-width: 92%; animation: hbSlideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    @keyframes hbSlideUp { 0% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }
    #hb-widget-wrapper .user-row { align-self: flex-end; flex-direction: row-reverse; }
    #hb-widget-wrapper .bot-row { align-self: flex-start; }
    #hb-widget-wrapper .avatar { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9em; flex-shrink: 0; box-shadow: var(--shadow-soft); }
    #hb-widget-wrapper .bot-avatar { background: var(--bg-header); color: white; margin-right: 8px; }
    #hb-widget-wrapper .user-avatar { background: var(--border-color); margin-left: 8px; }
    #hb-widget-wrapper .message-bubble { display: flex; flex-direction: column; }
    #hb-widget-wrapper .chat-display p { margin: 0; padding: 10px 14px; border-radius: 18px; line-height: 1.4; font-size: 0.9em; box-shadow: var(--shadow-soft); white-space: pre-wrap; }
    #hb-widget-wrapper .user-message { background: var(--bg-user-message); color: var(--text-user-message); border-bottom-right-radius: 4px !important; }
    #hb-widget-wrapper .bot-message { background: var(--bg-bot-message); color: var(--text-bot-message); border-bottom-left-radius: 4px !important; border: 1px solid var(--border-color); }

    #hb-widget-wrapper .typing-dots { display: flex; padding: 12px 16px; background: var(--bg-bot-message); border: 1px solid var(--border-color); border-radius: 18px; border-bottom-left-radius: 4px; width: max-content; }
    #hb-widget-wrapper .typing-dots span { width: 5px; height: 5px; background-color: var(--text-bot-message); border-radius: 50%; margin: 0 2px; animation: hbBounce 1.4s infinite ease-in-out both; opacity: 0.6; }
    #hb-widget-wrapper .typing-dots span:nth-child(1) { animation-delay: -0.32s; }
    #hb-widget-wrapper .typing-dots span:nth-child(2) { animation-delay: -0.16s; }
    @keyframes hbBounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

    #hb-widget-wrapper .chat-input-container { background-color: var(--bg-input-container); padding: 12px 16px 16px; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 10px; }
    #hb-widget-wrapper .button-options { display: flex; flex-wrap: wrap; gap: 8px; }
    #hb-widget-wrapper .button-options button.text-btn { background-color: var(--bg-option-button); color: var(--text-option-button); border: none; padding: 8px 14px; border-radius: 20px; cursor: pointer; font-size: 0.85em; font-weight: 500; transition: 0.2s ease; outline: none;}
    #hb-widget-wrapper .button-options button.text-btn:hover:not(:disabled) { background-color: var(--bg-option-button-hover); transform: translateY(-2px); }
    #hb-widget-wrapper .button-options button.icon-btn { width: 40px; height: 40px; border-radius: 50%; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s ease; outline: none; box-shadow: var(--shadow-soft); }
    #hb-widget-wrapper .button-options button.icon-btn svg { width: 20px; height: 20px; fill: #ffffff; }
    #hb-widget-wrapper .button-options button.icon-btn:hover:not(:disabled) { transform: scale(1.1); filter: brightness(1.1); }
    #hb-widget-wrapper .button-options button:disabled { background-color: var(--border-color) !important; cursor: not-allowed; box-shadow: none; opacity: 0.6; transform: none !important; }
    #hb-widget-wrapper .button-options button:disabled svg { fill: #94a3b8 !important; }

    #hb-widget-wrapper .chat-input { display: flex; align-items: center; gap: 8px; }
    #hb-widget-wrapper .chat-input input { flex: 1; border: 1px solid var(--border-color); background-color: var(--bg-input); color: var(--text-input); padding: 12px 16px; border-radius: 24px; font-size: 0.9em; outline: none; transition: 0.3s ease; }
    #hb-widget-wrapper .chat-input input:focus { border-color: var(--bg-send-button); box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1); }
    #hb-widget-wrapper .chat-input button.send-btn { background-color: var(--bg-send-button); color: var(--text-send-button); border: none; width: 42px; height: 42px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s ease; outline: none; flex-shrink: 0;}
    #hb-widget-wrapper .chat-input button.send-btn svg { width: 18px; height: 18px; fill: currentColor; margin-left: 2px; }
    #hb-widget-wrapper .chat-input button.send-btn:hover { transform: scale(1.05); }

    @media (max-width: 768px) {    
        #hb-widget-wrapper .chatbot-container { bottom: 16px; right: 16px; }
        #hb-widget-wrapper .chatbot { width: calc(100vw - 32px); height: 80vh; border-radius: 20px; }
    }
    </style>

