                suggestions: [{ text: "🧠 AI & Ecosystem" }, { text: "💻 Hardware Rescue" }, { text: "Main Menu" }]
            },
            {
                patterns: [/ecosystem|layers|ai models|gemini|claude|chatgpt/i],
                keywords: ["ecosystem", "layers", "models", "gemini", "claude", "chatgpt"],
                responses: ["Our ecosystem has 5 layers: Google Infra, Linux Systems, AI Implementation, Web Services, and Tech Education.\n\nFor AI, we support Gemini, Claude, ChatGPT, Perplexity, DeepSeek, and Grok. Need complete privacy? We deploy local on-device AI via Ollama and LM Studio."],
                suggestions: [{ text: "💸 Pricing & Savings" }, { text: "Main Menu" }]
            },
            {
                patterns: [/hardware|mac|windows|rescue|obsolete/i],
                keywords: ["hardware", "mac", "windows", "rescue", "obsolete"],
                responses: ["We bypass planned obsolescence! By replacing sluggish, locked-down operating systems with modern Linux or ChromeOS Flex, we extend the life of \"obsolete\" Intel Macs and PCs by 5 to 10 years."],
                suggestions: [{ text: "💸 Pricing & Savings" }, { text: "Main Menu" }]
