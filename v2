        const FALLBACK_RESPONSE = "I'm a simple automated assistant, so I might not understand that. Please select an option below to learn more!";
        const FALLBACK_SUGGESTIONS = [ { text: "🚀 What We Do" }, { text: "📞 Contact Us" } ];

        function levenshtein(a, b) {
            const matrix = Array.from({ length: b.length + 1 }, (_, i) => [i]);
            for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
            for (let i = 1; i <= b.length; i++) {
                for (let j = 1; j <= a.length; j++) {
                    if (b.charAt(i - 1) === a.charAt(j - 1)) {
                        matrix[i][j] = matrix[i - 1][j - 1];
                    } else {
                        matrix[i][j] = Math.min(matrix[i - 1][j - 1] + 1, Math.min(matrix[i][j - 1] + 1, matrix[i - 1][j] + 1));
                    }
                }
            }
            return matrix[b.length][a.length];
        }

        function getBotResponse(message) { 
            const rawMessage = message.trim();
            const cleanedMessage = rawMessage.toLowerCase(); 
            
            for (const item of predefinedResponses) { 
                if (item.patterns.some(p => p.test(cleanedMessage))) {
                    return { response: item.responses[0], suggestions: item.suggestions };
                }
            } 
            
            const words = cleanedMessage.replace(/[^\w\s]/g, '').split(/\s+/);
            for (const word of words) {
                if (word.length < 3) continue; 
                for (const item of predefinedResponses) {
                    if (!item.keywords) continue;
                    for (const keyword of item.keywords) {
                        const allowedTypos = keyword.length > 5 ? 2 : 1;
                        if (levenshtein(word, keyword) <= allowedTypos) {
                            return { response: item.responses[0], suggestions: item.suggestions };
                        }
                    }
                }
            }
            return { response: FALLBACK_RESPONSE, suggestions: FALLBACK_SUGGESTIONS }; 
        }

        const wrapper = document.getElementById('hb-widget-wrapper');
        const chatbot = document.getElementById('hb-chatbot');
        const chatDisplay = document.getElementById('hb-chatDisplay');
        const buttonOptions = document.getElementById('hb-buttonOptions');
        const userInput = document.getElementById('hb-userInput');
        const sendBtn = document.getElementById('hb-sendBtn');
        const minimizeBtn = document.getElementById('hb-minimizeBtn');
        const settingsBtn = document.getElementById('hb-settingsBtn');
        const settingsPanel = document.getElementById('hb-settingsPanel');
        const themeToggleBtn = document.getElementById('hb-themeToggleBtn');
        const muteToggleBtn = document.getElementById('hb-muteToggleBtn');
        const clearChatBtn = document.getElementById('hb-clearChatBtn');
        const messageReceivedSound = new Audio('https://www.fesliyanstudios.com/play-mp3/5455');

        let isMinimized = true;
        let isMuted = localStorage.getItem('hb_chatMuted') === 'true';
        let isDarkMode = localStorage.getItem('hb_chatDarkMode') === 'true';

        const MINIMIZED_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.92 2 10.75c0 2.8 1.54 5.3 3.93 6.91L5 22l4.43-2.16c.82.23 1.69.36 2.57.36 5.52 0 10-3.92 10-8.75S17.52 2 12 2z"></path></svg>`;
        const MAXIMIZED_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>`;

        document.getElementById('hb-botNameTitle').textContent = BUSINESS_NAME;
        document.getElementById('hb-botAvatarTitle').textContent = BOT_AVATAR_EMOJI;
        
        if(isDarkMode) wrapper.classList.add('hb-dark-mode');
        themeToggleBtn.textContent = isDarkMode ? "Light Mode" : "Dark Mode";
        muteToggleBtn.textContent = isMuted ? "Unmute Sounds" : "Mute Sounds";

        function isOfficeOpen() {
            const now = new Date();
            let localTimeStr = now.toLocaleString('en-US', { timeZone: OFFICE_HOURS.timezone });
            
            // Fix the formatting bug: Replace Narrow No-Break Space (\u202F) with a standard space
            localTimeStr = localTimeStr.replace(/\u202F/g, ' ');
            
            const localTime = new Date(localTimeStr);
            
            // Safeguard: If the browser still fails to parse the date, default to OPEN so you don't lose leads
            if (isNaN(localTime.getTime())) {
                return true; 
            }
            
            const day = localTime.getDay(); 
            const hour = localTime.getHours(); 
            
            return OFFICE_HOURS.workingDays.includes(day) && hour >= OFFICE_HOURS.startHour && hour < OFFICE_HOURS.endHour;
        }

        function addMessage(text, type, animate = true) { 
            const row = document.createElement('div');
            row.className = `message-row ${type}-row`;

            const avatar = document.createElement('div');
            avatar.className = `avatar ${type}-avatar`;
            avatar.innerHTML = type === 'bot' ? BOT_AVATAR_EMOJI : '👤';

            const bubbleContainer = document.createElement('div');
            bubbleContainer.className = 'message-bubble';

            const msgElement = document.createElement('p'); 
            msgElement.className = type === 'user' ? 'user-message' : 'bot-message'; 
            
            row.appendChild(avatar);
            row.appendChild(bubbleContainer);

            if (type === 'bot' && animate) { 
                const typingIndicator = document.createElement('div'); 
                typingIndicator.className = 'typing-dots'; 
                typingIndicator.innerHTML = '<span></span><span></span><span></span>'; 
                
                bubbleContainer.appendChild(typingIndicator); 
                chatDisplay.appendChild(row); 
                chatDisplay.scrollTop = chatDisplay.scrollHeight;
                
                setTimeout(() => {
                    bubbleContainer.replaceChild(msgElement, typingIndicator);
                    msgElement.textContent = text;
                    chatDisplay.scrollTop = chatDisplay.scrollHeight;
                    if (!isMuted) messageReceivedSound.play().catch(()=>{});
                }, 800);
            } else { 
                msgElement.textContent = text; 
                bubbleContainer.appendChild(msgElement); 
                chatDisplay.appendChild(row); 
                if(!animate) chatDisplay.scrollTop = chatDisplay.scrollHeight;
            } 
        }

        function updateButtonOptions(suggestions) { 
            buttonOptions.innerHTML = ''; 
            const currentlyOpen = isOfficeOpen();

            (suggestions || []).forEach(suggestion => { 
                const btn = document.createElement('button'); 
                const isIcon = typeof suggestion === 'object' && suggestion.iconOnly;
                
                if (isIcon) {
                    btn.className = 'icon-btn';
                    btn.innerHTML = suggestion.svg;
                    btn.style.backgroundColor = suggestion.color;
                    btn.title = suggestion.title || "Contact Link";
                    
                    if (suggestion.action === 'call' && !currentlyOpen) {
                        btn.disabled = true;
                        btn.title = "Our phone lines are currently closed.";
                        btn.style.backgroundColor = ""; 
                    } else {
                        btn.onclick = () => window.open(suggestion.url, '_blank');
                    }
                } 
                else {
                    const text = typeof suggestion === 'string' ? suggestion : suggestion.text;
                    btn.className = 'text-btn';
                    btn.textContent = text; 
                    btn.onclick = () => handleUserInput(text); 
                }
                
                buttonOptions.appendChild(btn); 
            }); 
        }

        function processQuery(message) { 
            buttonOptions.innerHTML = ''; 
            const { response, suggestions } = getBotResponse(message); 
            addMessage(response, 'bot', true); 
            setTimeout(() => updateButtonOptions(suggestions), 800);
        }

        function handleUserInput(text = userInput.value.trim()) {
            if (!text) return;
            addMessage(text, 'user', false); 
            userInput.value = ''; 
            processQuery(text); 
        }

        function setChatbotState(minimized) {    
            isMinimized = minimized;    
            chatbot.classList.toggle("minimized", isMinimized);    
            settingsPanel.classList.remove('open');
            
            if (isMinimized) {        
                minimizeBtn.innerHTML = MINIMIZED_ICON_SVG;
            } else {        
                minimizeBtn.innerHTML = MAXIMIZED_ICON_SVG;        
                setTimeout(() => chatDisplay.scrollTop = chatDisplay.scrollHeight, 50);    
            }
        }

        sendBtn.onclick = () => handleUserInput();
        userInput.onkeypress = (e) => { if (e.key === 'Enter') handleUserInput(); };
        minimizeBtn.onclick = (e) => { e.stopPropagation(); setChatbotState(!isMinimized); };
        document.getElementById('hb-chatbotHeader').onclick = (e) => { 
            if (e.target.closest('#hb-minimizeBtn') || e.target.closest('#hb-settingsBtn')) return;
            setChatbotState(!isMinimized); 
        };

        settingsBtn.onclick = (e) => {
            e.stopPropagation();
            settingsPanel.classList.toggle('open');
        };

        themeToggleBtn.onclick = () => {
            isDarkMode = !isDarkMode;
            wrapper.classList.toggle('hb-dark-mode', isDarkMode);
            themeToggleBtn.textContent = isDarkMode ? "Light Mode" : "Dark Mode";
            localStorage.setItem('hb_chatDarkMode', isDarkMode);
        };

        muteToggleBtn.onclick = () => {
            isMuted = !isMuted;
            muteToggleBtn.textContent = isMuted ? "Unmute Sounds" : "Mute Sounds";
            localStorage.setItem('hb_chatMuted', isMuted);
        };

        clearChatBtn.onclick = () => {
            chatDisplay.innerHTML = '';
            settingsPanel.classList.remove('open');
            processQuery("hello");
        };

        // --- Flash Open Logic ---
        const hasFlashed = sessionStorage.getItem('hb_flashed');

        if (!hasFlashed) {
            setChatbotState(true); 
            setTimeout(() => {
                setChatbotState(false); 
                processQuery("hello"); 
                
                setTimeout(() => {
                    if (!isMinimized) { 
                        setChatbotState(true); 
                    }
                }, 4000); 
                
                sessionStorage.setItem('hb_flashed', 'true');
            }, 1000); 
        } else {
            setChatbotState(true);
        }
        
        document.getElementById('hb-chatbotHeader').addEventListener('click', function initOnce() {
            if(chatDisplay.children.length === 0) processQuery("hello");
            document.getElementById('hb-chatbotHeader').removeEventListener('click', initOnce);
        });

    })(); 
    </script>
</div>
<!-- End of HashBro Business Concierge Widget -->
